# All variables are optional. With none set, VOW runs in demo mode: the Noa & Daniel
# wedding (350 guests) lives in the visitor's browser and every feature works.

# Public site URL (canonical links, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=

# Supabase: set both to switch from demo mode to the real backend.
# Run supabase/migrations/20261116000000_init.sql in the project first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude API: enables AI-written invitations. Without it the built-in composer is used.
ANTHROPIC_API_KEY=
# VOW_AI_MODEL=claude-opus-5-5

# WhatsApp Business Cloud API (optional). Default is wa.me share links.
# NEXT_PUBLIC_WHATSAPP_PROVIDER=cloud
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANGUAGE=he
